# Copy to .env and fill in values before running docker compose

JWT_SECRET_KEY=change-this-dev-secret-key-min-32-chars-long!!

# Optional — required only if running uploader-service
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — use GCS uploader instead of Cloudinary
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_JSON=
